{
  "name": "api-todo",
  "version": "0.0.0",
  "private": true,
  "author": "M. Ilham Margatama",
  "scripts": {
    "build": "swc src -d dist --copy-files && tsc-alias -p tsconfig.json",
    "clean": "rm -rf dist",
    "copy-env": "node -e \"process.platform === 'win32' ? process.exit(0) : process.exit(1)\" && npm run copy-env:windows || npm run copy-env:linux",
    "copy-env:linux": "cp -f .env dist/",
    "copy-env:windows": "powershell -Command \"Copy-Item -Path '.env' -Destination 'dist/' -Force;\"",
    "copy-credentials": "node -e \"process.platform === 'win32' ? process.exit(0) : process.exit(1)\" && npm run copy-credentials:windows || npm run copy-credentials:linux",
    "copy-credentials:linux": "mkdir -p dist && cp -rf src/credentials dist/",
    "copy-credentials:windows": "powershell -Command \"Copy-Item -Path 'src/credentials' -Destination 'dist/' -Recurse -Force\"",
    "dev": "nodemon --exec \"npx tsx ./src/index.ts\" -e ts",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "postbuild": "npm run copy-env && npm run copy-credentials",
    "start": "node -r esbuild-register ./src/index.ts",
    "test": "jest --detectOpenHandles"
  },
  "jest": {
    "preset": "@repo/jest-presets/node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "type": "commonjs",
  "dependencies": {
    "@repo/logger": "^0.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@babel/register": "^7.28.6",
    "@jest/globals": "^30.2.0",
    "@repo/eslint-config": "^0.0.0",
    "@repo/jest-presets": "^0.0.0",
    "@repo/typescript-config": "^0.0.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.26",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.39",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.12",
    "esbuild-register": "^3.6.0",
    "eslint": "^9.39.4",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "5.9.3"
  }
}
